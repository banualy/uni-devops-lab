services:
  app:
    image: {{ app_image }}
    build:
      context: ./app
      dockerfile: Dockerfile
    container_name: student-portal
    ports:
      - "{{ app_port }}:{{ container_port }}"
    environment:
      REDIS_HOST: redis
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: student-redis
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

volumes:
  redis_data:
